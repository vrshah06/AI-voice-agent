# Application Configuration
APP_NAME="AI Receptionist Medical Clinic MVP"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"
LOG_LEVEL="INFO"

# Security & Webhook Authentication
# Used to authenticate incoming tool requests from Retell AI or external clients.
# Leave empty in development to allow unauthenticated local testing if desired,
# or specify a secret key for production/ngrok tunnel exposure.
RETELL_API_KEY="key_0f293e950a9456f5d995f640ac81"
WEBHOOK_SECRET_KEY="demo-clinic-secret-key-12345"

# Clinic Demo Information
CLINIC_NAME="Md Primary Care INC"
CLINIC_PHONE="(561) 208-6041"
CLINIC_HOURS="Monday to Friday, 8:00 AM to 5:00 PM EST"

# eClinicalWorks (eCW) SMART Backend Services Integration
# Set to 'true' once client_id is approved on the eCW Developer Portal
ECW_ENABLED=false
ECW_ENV="sandbox"
# Client Id issued upon registering a 'Backend App' on https://fhir.eclinicalworks.com/ecwopendev/
ECW_CLIENT_ID="your-ecw-client-id-here"
# Key ID matching the 'kid' published in your JWKS endpoint
ECW_KEY_ID="ecw-key-1"
# Private key PEM content (store in Render secret in production; in local dev fallback to keys/private_key.pem)
ECW_PRIVATE_KEY=""
# Sandbox token endpoint from official eCW Developer Portal documentation
ECW_TOKEN_URL="https://staging-oauthserver.ecwcloud.com/oauth/oauth2/token"
# Practice FHIR endpoint URL (provided upon practice activation in eCW)
ECW_FHIR_BASE_URL="https://staging-fhir.ecwcloud.com/fhir/r4/YOUR_PRACTICE_ID"
# Approved system scopes
ECW_SCOPES="system/Patient.read"
