# Application Configuration
APP_NAME="AI Receptionist Medical Clinic Backend"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"
LOG_LEVEL="INFO"

# Security & Webhook Authentication
# Used to authenticate incoming tool requests from Retell AI or external webhook clients.
RETELL_API_KEY="key_0f293e950a9456f5d995f640ac81"
WEBHOOK_SECRET_KEY="demo-clinic-secret-key-12345"
BACKEND_BASE_URL="https://ai-voice-agent-jlez.onrender.com"

# Clinic Profile Information
CLINIC_NAME="Md Primary Care INC"
CLINIC_PHONE="(561) 208-6041"
CLINIC_HOURS="Monday to Friday, 8:00 AM to 5:00 PM EST"

# =====================================================================
# eClinicalWorks (eCW) SMART Backend Services Configuration
# =====================================================================
# Enable live eCW EHR connectivity
ECW_ENABLED=true

# Environment: 'sandbox' or 'production'
ECW_ENV="production"

# Client ID for sandbox issued upon registering your Provider App on https://fhir.eclinicalworks.com/ecwopendev/
#ECW_CLIENT_ID="Gbv1wmaq-H0lhO0kplpUZy1gCRKZ9719BO38y4rzwIQ" # for sandbox
ECW_CLIENT_ID = "b_ZpwoiCe2LZ-R42ue4waq0IUEWxQVe_AYSJD4K5xVs" # for production
# Key ID matching the 'kid' published in your public JWKS endpoint (/.well-known/jwks.json)
ECW_KEY_ID="ecw-key-1"

# RSA Private Key (PEM format).
# In production (e.g., Render/AWS), provide the multi-line PEM string via this secret environment variable.
# In local development, leave blank to fall back to ECW_PRIVATE_KEY_PATH.
ECW_PRIVATE_KEY=""
ECW_PRIVATE_KEY_PATH="keys/private_key.pem"
ECW_PUBLIC_KEY_PATH="keys/public_key.pem"

# eClinicalWorks OAuth 2.0 Token Endpoint:
# - Sandbox: https://staging-oauthserver.ecwcloud.com/oauth/oauth2/token
# - Production: https://oauthserver.eclinicalworks.com/oauth/oauth2/token
ECW_TOKEN_URL="https://oauthserver.eclinicalworks.com/oauth/oauth2/token"

# Practice FHIR R4 Endpoint URL (assigned upon practice activation in eCW):
# - Sandbox Example: https://staging-fhir.ecwcloud.com/fhir/r4/FFBJCD
# - Production Example: https://fhir4.eclinicalworks.com/fhir/r4/BDGDCD
ECW_FHIR_BASE_URL="https://fhir4.eclinicalworks.com/fhir/r4/BDGDCD"

# Authorized SMART on FHIR backend service scopes (RFC 7523)
ECW_SCOPES="system/Patient.read"

# Client assertion validity window in seconds (eCW standard: 300)
ECW_ASSERTION_EXPIRY_SECONDS=300
